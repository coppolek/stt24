rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    match /roles/{userId} {
      allow read, write: if true;
    }

    match /tickets/{ticketId} {
      allow read, write: if true;
    }
  }
}

